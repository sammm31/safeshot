{
  "expo": {
    "name": "WireCheck",
    "slug": "WireCheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.wirecheck.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B132B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow WireCheck to access your camera to inspect wires and electrical components."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow WireCheck to access your photos to select wire inspection images."
        }
      ]
    ]
  }
}
